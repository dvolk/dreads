    <h1>Settings</h1>
    <form id="settingsform" action="/apply_settings">
      Zoom
      <input style="vertical-align: middle" name="zoom" type="range" min="0.5" max="1.5" step="0.05" value="{{ session.get('zoom', 1) }}"/>
      Margins
      <input style="vertical-align: middle" name="margin" type="range" min="0" max="0.9" step="0.05" value="{{ session.get('margin', 0) }}"/>
      Color
      <input style="vertical-align: middle" name="color" type="color" value="{{ session.get('color', '#000000') }}"/>
      Layout
      <select style="vertical-align: middle" name="layout">
        <option value="list"{% if layout == "list" %} selected{% endif %}>list</option>
        <option value="grid"{% if layout == "grid" %} selected{% endif %}>grid</option>
      </select>
      <input style="vertical-align: middle; padding: 5px 10px; margin: 10px; background-color: steelblue; color: white; border: 0px;" type="Submit"/ value="Apply">
    </form>
    <form action="/trigger_load_books">
      <input style="border-radius: 5px; vertical-align: middle; padding: 5px 10px; margin: 10px; background-color: steelblue; color: white; border: 0px;" type="Submit" value="Reload books"/>
    </form>
    <h1>Search</h1>
    <form method="GET">
      <center>
        <input name="q" placeholder="search (eg: title:'Book Title' author:'Author Name' tag:fiction tag:!sci-fi sort:!date)" style="border-radius: 10px; padding: 6px; width: 95%" {% if q %}value="{{q|escape}}"{% endif %}>
      </center>
    </form>
